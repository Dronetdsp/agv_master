# Backend Configuration
DEBUG=false
HOST=0.0.0.0
PORT=8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=sqlite+aiosqlite:///./crack_detection.db

# ML Model Paths (adjust to your environment)
DEFAULT_CRACK_MODEL=/models/yolov8s_crack_seg4/weights/best.pt
DEFAULT_DET_MODEL=/models/merged_unified6_a10012/weights/best.pt

# File Upload
MAX_UPLOAD_SIZE=104857600  # 100MB in bytes

# Default Inference Parameters
DEFAULT_IMGSZ=1024
DEFAULT_CRACK_CONF=0.25
DEFAULT_DET_CONF=0.35
DEFAULT_MM_PER_PIXEL=1.0
DEFAULT_MIN_BOX_PX=40
DEFAULT_MIN_MASK_AREA_PX=250
DEFAULT_TOPK_BASE=5
DEFAULT_TOPK_MAX=7
DEFAULT_HIGH_SEVERITY_TH=5000.0

# Security (change in production!)
SECRET_KEY=your-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days
